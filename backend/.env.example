# Copy to .env (never commit .env). Only the backend ever sees these values.
# On Cloud Run this whole file is uploaded as the repo's DOTENV secret: gh secret set DOTENV < .env

# --- OpenRouter (all model calls) ---
OPENROUTER_API_KEY=
# OpenRouter model IDs ("vendor/model"). Screening + vision, then the cheap model for the classifier
# and the Red-Team payload writer. A cheaper vision alternative: google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL=openai/gpt-5.4-mini
OPENROUTER_VISION_MODEL=openai/gpt-5.4-mini
OPENROUTER_CHEAP_MODEL=openai/gpt-5.4-nano
# Default reasoning effort, sent as OpenRouter's reasoning.effort; leave empty to never send it
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT=60

# Reasoning effort per task. If the API rejects "minimal", "low" is used instead.
REASONING_VISION=minimal
REASONING_CLASSIFY=minimal
REASONING_SCREEN=low
REASONING_PAYLOAD=minimal

# Output token caps per task. A response cut off at the cap is retried once with double the cap.
MAX_TOKENS_VISION=4000
MAX_TOKENS_CLASSIFY=2000
MAX_TOKENS_SCREEN=2500
MAX_TOKENS_PAYLOAD=1500

# --- CORS: comma-separated frontend origins (add the Vercel URL after the first deploy) ---
CORS_ORIGINS=http://localhost:3000

# --- Upload limits ---
MAX_FILE_MB=10
MAX_PAGES=5

# --- Rate limiting (shared AI Lodge engine, Upstash Redis). Leave the Upstash vars empty to disable locally. ---
# The short names UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback max requests per IP per window for each bucket (the central control sheet overrides these)
RATE_LIMIT_SCAN_MAX=5
RATE_LIMIT_SCREEN_MAX=5
RATE_LIMIT_REDTEAM_MAX=5
# Rolling window in seconds (432000 = 5 days)
RATE_LIMIT_WINDOW_SECONDS=432000

# --- Offline eval CLI only (python -m eval.run_eval fuzz): per-round caps ---
FUZZ_MAX_ATTACKS=30
FUZZ_TOKEN_BUDGET=200000
